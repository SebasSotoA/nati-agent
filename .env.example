# ---------------------------------------------------------------------------
# Copy this file to `.env` and paste the key in:
#
#     cp .env.example .env
#     uv run nati serve
#
# THE KEY IS THE ONLY THING YOU HAVE TO SET. You do not choose or configure a
# model — one is already selected in profiles.toml, the region is fixed there
# too, and the world database builds itself the first time you run `serve`.
#
# `.env` is in .gitignore. DO NOT commit it: the Bedrock key can incur spend,
# and this repo is handed to the people who will attack the agent.
# ---------------------------------------------------------------------------

# The team's AWS Bedrock key (shared by whoever administers the account).
# AWS_BEARER_TOKEN_BEDROCK is also accepted if you already have it under that name.
NATI_API_KEY=

# Your name. Recorded in every trace so findings and Bedrock spend can be
# attributed. If you leave it empty, traces will say "anonymous".
NATI_USER=
