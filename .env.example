# ---------------------------------------------------------------------------
# Copy this file to `.env` and paste the key in:
#
#     cp .env.example .env
#     uv run nati serve
#
# THE KEY IS THE ONLY THING YOU HAVE TO SET. You do not choose or configure a
# model — one is already selected in profiles.toml, and the world database
# builds itself the first time you run `serve`.
#
# `.env` is in .gitignore. DO NOT commit it: the Ollama API key can incur spend,
# and this repo is handed to the people who will attack the agent.
# ---------------------------------------------------------------------------

# The Ollama Cloud API key.
# OLLAMA_API_KEY is also accepted.
NATI_API_KEY=

# Your name. Recorded in every trace so findings can be attributed.
# If you leave it empty, traces will say "anonymous".
NATI_USER=

# Optional: override the model id from profiles.toml for one run.
NATI_MODEL=
